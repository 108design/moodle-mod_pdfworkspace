{{!
    @template mod_pdfworkspace/course_document_picker

    Checkbox view of the native course PDF multiselect.

    Example context (json):
    {
        "sections": [{
            "id": 24,
            "label": "Reading",
            "sources": [{
                "name": "Background material",
                "type": "Folder",
                "grouped": true,
                "files": [{"id": 38, "label": "Week 1/Introduction.pdf"}]
            }],
            "sections": []
        }]
    }
}}
<details class="pdfworkspace-course-picker d-none" data-region="course-pdf-picker">
    <summary class="fw-semibold">
        {{#str}} courseimportbrowse, mod_pdfworkspace {{/str}}
        <span class="ms-2 small text-body-secondary fw-normal" data-region="course-pdf-count" role="status"></span>
    </summary>
    <div class="mt-2">
        <label class="accesshide" for="pdfworkspace-course-pdf-search">{{#str}} courseimportsearch, mod_pdfworkspace {{/str}}</label>
        <input class="form-control mb-2" id="pdfworkspace-course-pdf-search" type="search"
               placeholder="{{#str}} courseimportsearch, mod_pdfworkspace {{/str}}" data-action="filter-course-pdfs">
        <div class="text-body-secondary small d-none mb-2" data-region="course-pdf-empty" role="status">
            {{#str}} courseimportnomatch, mod_pdfworkspace {{/str}}
        </div>
        {{> mod_pdfworkspace/course_document_sections }}
    </div>
</details>
