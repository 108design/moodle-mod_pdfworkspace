{{!
    @template mod_pdfworkspace/question_dashboard

    Quick links for teachers to unanswered questions and pages with several authors.

    Example context (json):
    {
        "unanswered": 3,
        "unansweredurl": "#",
        "pages": [{
            "title": "Handout",
            "pagelabel": "PDF Page 7",
            "countlabel": "5 questions from 4 people",
            "barwidth": 100,
            "url": "#"
        }]
    }
}}
<div class="pdfworkspace-question-dashboard gap-3 mb-3">
    <section class="card{{#unansweredactive}} border-primary{{/unansweredactive}}" aria-labelledby="pdfworkspace-unanswered-title">
        <div class="card-header px-4">
            <h3 class="h6 fw-bold mb-0" id="pdfworkspace-unanswered-title">
                {{#str}}openunansweredquestions, mod_pdfworkspace{{/str}}
            </h3>
        </div>
        <div class="card-body px-4">
            <strong class="h2 d-block mb-0">{{unanswered}}</strong>
        </div>
        <div class="card-footer px-4">
            <a href="{{unansweredurl}}" class="stretched-link" aria-describedby="pdfworkspace-unanswered-title"
                    {{#unansweredactive}}aria-current="true"{{/unansweredactive}}>
                {{#str}}overviewshowquestions, mod_pdfworkspace{{/str}} <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
    <section class="card" aria-labelledby="pdfworkspace-question-clusters">
        <div class="card-header px-4 d-flex align-items-center gap-2">
            <h3 class="h6 fw-bold mb-0" id="pdfworkspace-question-clusters">
                {{#str}}overviewquestionclusters, mod_pdfworkspace{{/str}}
            </h3>
            {{{help}}}
        </div>
        <div class="card-body px-4">
            <ul class="list-unstyled mb-0">
                {{#pages}}
                    <li>
                        <a href="{{url}}" class="pdfworkspace-question-cluster d-block rounded py-2 px-1{{#active}} border border-primary{{/active}}"
                                {{#active}}aria-current="true"{{/active}}>
                            <span class="pdfworkspace-question-cluster-label">
                                <span><strong>{{title}}</strong> · {{pagelabel}}</span>
                                <span>{{countlabel}}</span>
                            </span>
                            <span class="progress mt-1" aria-hidden="true">
                                <span class="progress-bar" style="width: {{barwidth}}%"></span>
                            </span>
                        </a>
                    </li>
                {{/pages}}
            </ul>
            {{^pages}}
                <p class="text-muted mb-0">{{#str}}nooverviewquestionclusters, mod_pdfworkspace{{/str}}</p>
            {{/pages}}
        </div>
        <div class="card-footer px-4" aria-hidden="true"></div>
    </section>
</div>
